<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The host renders Blazor components from Elsa packages but has no local .razor files. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Elsa.Studio" Version="3.6.1" />
    <PackageReference Include="Elsa.Studio.Core.BlazorServer" Version="3.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Elsa.Aspire.ServiceDefaults\Elsa.Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Elsa.Studio.Keycloak\Elsa.Studio.Keycloak.csproj" />
  </ItemGroup>

</Project>
